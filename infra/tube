# nginx site — /etc/nginx/sites-available/tube
#
# nginx is the only TLS terminator. It proxies to Node over plain loopback HTTP.
# v1 used `proxy_pass https://127.0.0.1:3003` into a Node process that was doing its
# own TLS with certs for a different domain, which is why the SSL config kept breaking.

server {
  listen 80;
  listen [::]:80;
  server_name tube.quinzel.tech www.tube.quinzel.tech;

  location /.well-known/acme-challenge/ {
    root /var/www/html;
  }

  location / {
    return 301 https://tube.quinzel.tech$request_uri;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name www.tube.quinzel.tech;

  ssl_certificate /etc/letsencrypt/live/quinzel.tech/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/quinzel.tech/privkey.pem;

  return 301 https://tube.quinzel.tech$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name tube.quinzel.tech;

  ssl_certificate /etc/letsencrypt/live/quinzel.tech/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/quinzel.tech/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000" always;

  # Static files are served straight off disk; Node only ever sees /api.
  root /root/tube/dist;

  location /api/ {
    proxy_pass http://127.0.0.1:3003;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # express `trust proxy` reads this to rate-limit on the real client IP.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
