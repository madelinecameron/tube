# Copy to .env and fill in.  cp .env.example .env
#
# .env is gitignored. Keep it mode 600 on the server:  chmod 600 .env

# ---- required ----

# YouTube Data API v3 key.
#   https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Restrict it to the YouTube Data API in Google Cloud, and use a key dedicated to
# this app — sharing one key across projects is itself a policy violation.
# Search costs 100 quota units against a 10,000/day default, so ~100 searches/day.
YOUTUBE_API_KEY=

# ---- required for Docker only ----

# The hostname Caddy will obtain a TLS certificate for. Its DNS A/AAAA record must
# already point at this box, or the certificate request will fail.
# Use `localhost` to try the stack locally (Caddy issues its own internal cert).
DOMAIN=tube.quinzel.tech

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=me@maddie.today

# ---- optional ----

# Only used when running outside Docker (`npm start`). Compose sets these itself:
# the container binds 0.0.0.0 so Caddy can reach it, and is never published to the host.
PORT=3003
HOST=127.0.0.1
